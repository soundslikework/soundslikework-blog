{
  "main": "dist/_worker.js/index.js",
  "name": "soundslikework-blog",
  "compatibility_date": "2025-09-27",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "dist"
  },
  "observability": {
    "enabled": true
  },
  // SEND_EMAIL destination_address must match your verified Cloudflare Email Routing address.
  "send_email": [
    {
      "name": "SEND_EMAIL",
      "destination_address": "adampaulbrady@gmail.com"
    }
  ],
  // TURNSTILE_SECRET_KEY is set via: wrangler secret put TURNSTILE_SECRET_KEY
  "$schema": "node_modules/wrangler/config-schema.json"
}
