{
  "main": "dist/_worker.js/index.js",
  "name": "soundslikework-blog",
  "compatibility_date": "2025-09-27",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "dist"
  },
  "observability": {
    "enabled": true
  },
  // Unrestricted binding — destination set at runtime via CONTACT_TO env var / secret.
  // Can send to any verified Email Routing address on the Cloudflare account.
  "send_email": [
    {
      "name": "SEND_EMAIL"
    }
  ],
  // TURNSTILE_SECRET_KEY is set via: wrangler secret put TURNSTILE_SECRET_KEY
  "$schema": "node_modules/wrangler/config-schema.json"
}
