---
import { SITE } from "../site";
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import about from "../assets/images/about/sounds-like-work.jpg";
---

<BaseLayout title="About" description={`About ${SITE.name}.`}>
  <Header />
  <main class="page-container py-12">
    <h1 class="page-title mb-6">About</h1>
    <div class="prose prose-lg prose-retro max-w-none leading-relaxed">
      <p>I make nasty, noisy feedbacky music.</p>
      <p>
        This is yet another blog I'm starting with this title that I picked at
        random when I was about 18. I've been playing guitar for 20+ years -
        it's high time I started cataloging my thoughts on the things I use and
        enjoy. You're welcome to follow along.
      </p>
      <img
        src={about.src}
        alt="The author in glasses and a beard playing a red guitar"
        width={200}
        height={200}
        class="mx-auto rounded-sm"
      />
    </div>
  </main>
  <Footer /></BaseLayout
>
