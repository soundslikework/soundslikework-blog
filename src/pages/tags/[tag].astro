---
import { getPosts } from '../../posts';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PostCard from '../../components/PostCard.astro';

export async function getStaticPaths() {
  const posts = await getPosts();
  const allTags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return allTags.map((tag) => ({
    params: { tag },
    props: {
      posts: posts
        .filter((p) => p.data.tags.includes(tag)),
    },
  }));
}

const { tag } = Astro.params;
const { posts } = Astro.props;
---

<BaseLayout title={`#${tag}`} description={`Posts tagged with #${tag}`} noindex>
  <Header />
  <main class="page-container py-12">
    <h1 class="page-title mb-2">#{tag}</h1>
    <p class="text-ink-muted text-sm mb-10">{posts.length} post{posts.length !== 1 ? 's' : ''}</p>
    <div>
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </main>
  <Footer />
</BaseLayout>
