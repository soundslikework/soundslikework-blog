---
import { SITE } from "../site";
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SectionHeading from "../components/SectionHeading.astro";
import PostCard from "../components/PostCard.astro";

import hero from "../assets/images/index/hero.jpeg";

import { getPosts } from "../posts";

const posts = await getPosts();

const [featured, ...rest] = posts;

const formattedDate = featured?.data.date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
});
---

<BaseLayout
  title="Home"
  seoTitle={SITE.homeTitle}
>
  <Header />

  <div class="relative w-full h-72 md:h-96 overflow-hidden">
    <img
      src={hero.src}
      alt="Hero image of pedals"
      class="w-full h-full object-cover object-top"
    />
    <div
      class="absolute inset-x-0 bottom-0 h-48 bg-linear-to-t from-paper to-transparent"
    >
    </div>
  </div>

  <main class="page-container py-12">
    {
      featured && (
        <section class="mb-14">
          <SectionHeading class="mb-8">Latest Post</SectionHeading>
          <a href={`/posts/${featured.id}`} class="no-underline group block">
            {featured.data.gear && (
              <p class="label text-accent tracking-label-wide font-medium mb-2">
                {featured.data.gear.make} / {featured.data.gear.model}
              </p>
            )}
            <h2 class="font-serif text-3xl font-bold text-ink group-hover:text-accent transition-colors mb-3 leading-tight">
              {featured.data.title}
            </h2>
            <p class="text-ink/70 leading-relaxed mb-4">
              {featured.data.description}
            </p>
            <div class="flex items-center gap-4">
              <time class="label text-ink/50 tracking-label">
                {formattedDate}
              </time>
              {featured.data.tags.length > 0 && (
                <div class="flex gap-2">
                  {featured.data.tags.map((tag) => (
                    <span class="label text-accent/70 tracking-label">
                      #{tag}
                    </span>
                  ))}
                </div>
              )}
              <span class="label text-accent tracking-label-wide ml-auto">
                Read →
              </span>
            </div>
          </a>
        </section>
      )
    }

    {
      rest.length > 0 && (
        <section>
          <SectionHeading class="mb-2">Previously</SectionHeading>
          <div>
            {rest.map((post) => (
              <PostCard post={post} />
            ))}
          </div>
        </section>
      )
    }
  </main>
  <Footer />
</BaseLayout>
