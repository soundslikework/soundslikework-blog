---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<BaseLayout title="Home" description="Guitar pedal reviews and demos.">
  <Header />
  <main class="max-w-2xl mx-auto px-6 md:px-8 py-12">
    <h1 class="font-serif text-4xl font-bold mb-2">All Posts</h1>
    <p class="text-ink/60 mb-10 text-sm uppercase tracking-widest">Guitar pedal reviews &amp; demos</p>
    <div>
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </main>
  <Footer />
</BaseLayout>
