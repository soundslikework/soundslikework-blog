---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PostCard from "../components/PostCard.astro";

import hero from "../assets/images/index/hero.jpeg";

import { getCollection } from "astro:content";

const posts = (await getCollection("posts")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const [featured, ...rest] = posts;

const formattedDate = featured?.data.date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
});
---

<BaseLayout
  title="Home"
  description="Gear reviews — guitars, pedals, amps, and basses."
>
  <Header />

  <div class="relative w-full h-72 md:h-96 overflow-hidden">
    <img
      src={hero.src}
      alt="Hero image of pedals"
      class="w-full h-full object-cover object-top"
    />
    <div
      class="absolute inset-x-0 bottom-0 h-48 bg-linear-to-t from-paper to-transparent"
    >
    </div>
  </div>

  <main class="max-w-2xl mx-auto px-6 md:px-8 py-12">
    {
      featured && (
        <section class="mb-14">
          <div class="flex items-center gap-3 mb-8">
            <div class="h-px w-8 bg-accent opacity-50" />
            <p class="font-mono text-[10px] text-ink/50 uppercase tracking-[0.25em]">
              Latest Post
            </p>
            <div class="h-px flex-1 bg-ink/10" />
          </div>
          <a href={`/posts/${featured.slug}`} class="no-underline group block">
            {featured.data.gear && (
              <p class="font-mono text-accent text-[10px] uppercase tracking-[0.2em] font-medium mb-2">
                {featured.data.gear.make} / {featured.data.gear.model}
              </p>
            )}
            <h2 class="font-serif text-3xl font-bold text-ink group-hover:text-accent transition-colors mb-3 leading-tight">
              {featured.data.title}
            </h2>
            <p class="font-body text-ink/70 leading-relaxed mb-4">
              {featured.data.description}
            </p>
            <div class="flex items-center gap-4">
              <time class="font-mono text-[10px] text-ink/50 uppercase tracking-[0.15em]">
                {formattedDate}
              </time>
              {featured.data.tags.length > 0 && (
                <div class="flex gap-2">
                  {featured.data.tags.map((tag) => (
                    <span class="font-mono text-[10px] text-accent/70 uppercase tracking-[0.15em]">
                      #{tag}
                    </span>
                  ))}
                </div>
              )}
              <span class="font-mono text-[10px] text-accent uppercase tracking-[0.2em] ml-auto">
                Read →
              </span>
            </div>
          </a>
        </section>
      )
    }

    {
      rest.length > 0 && (
        <section>
          <div class="flex items-center gap-3 mb-2">
            <div class="h-px w-8 bg-accent opacity-50" />
            <p class="font-mono text-[10px] text-ink/50 uppercase tracking-[0.25em]">
              Previously
            </p>
            <div class="h-px flex-1 bg-ink/10" />
          </div>
          <div>
            {rest.map((post) => (
              <PostCard post={post} />
            ))}
          </div>
        </section>
      )
    }
  </main>
  <Footer />
</BaseLayout>
