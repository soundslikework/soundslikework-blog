---
import type { CollectionEntry } from 'astro:content';
import CoverImage from './CoverImage.astro';
import { tagUrl } from '../posts';

interface Props {
  post: CollectionEntry<'posts'>;
  featured?: boolean; // bigger image and title, no tags; for the latest post
}

const { post, featured = false } = Astro.props;
const { title, date, description, coverImage, gear, tags, author } = post.data;
const url = `/posts/${post.id}`;

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<article class:list={['group', featured ? '' : 'border-b border-ink/15 py-8']}>
  <a href={url} class="no-underline block">
    {coverImage && (
      <CoverImage
        src={coverImage}
        gear={gear}
        title={title}
        eager={featured}
        class={featured ? 'md:aspect-11/5 mb-5' : 'md:aspect-11/3 mb-4'}
      />
    )}
    {gear && (
      <p class:list={['gear-name', featured ? 'mb-2' : 'mb-1']}>
        {gear.make} / {gear.model}
      </p>
    )}
    <h2 class:list={['font-serif font-bold text-ink group-hover:text-accent transition-colors', featured ? 'text-4xl leading-tight mb-3' : 'text-xl leading-snug mb-2']}>
      {title}
    </h2>
    <p class:list={['text-ink-muted leading-relaxed', featured ? 'mb-4' : 'text-sm']}>{description}</p>
    {featured && (
      <div class="flex items-center gap-4">
        <time class="label text-ink-muted">{formattedDate}</time>
        <span class="font-mono text-xs text-accent ml-auto">Read →</span>
      </div>
    )}
  </a>
  {!featured && (
    <div class="flex items-center gap-4 mt-3">
      <time class="label text-ink-muted">{formattedDate}</time>
      {author && <span class="font-mono text-xs text-ink-muted">by {author}</span>}
      <div class="flex gap-2">
        {tags.map((tag) => (
          <a href={tagUrl(tag)} class="tag">#{tag}</a>
        ))}
      </div>
    </div>
  )}
</article>
