---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { tagUrl } from '../posts';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { title, date, description, coverImage, gear, tags, author } = post.data;
const url = `/posts/${post.id}`;

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<article class="border-b border-ink/15 py-8 group relative pl-0 hover:pl-4 transition-all duration-300">
  <div class="absolute left-0 top-0 bottom-0 w-0.5 bg-accent scale-y-0 group-hover:scale-y-100 transition-transform duration-300 origin-top"></div>
  <a href={url} class="no-underline block">
    {coverImage ? (
      <div class="mb-4 overflow-hidden rounded-sm">
        <Image
          src={coverImage}
          alt={`${gear?.make ?? ''} ${gear?.model ?? title}`}
          width={680}
          height={400}
          class="w-full object-cover h-48 grayscale group-hover:grayscale-0 transition-all duration-500"
        />
      </div>
    ) : (
      <div class="mb-4 h-1 w-12 bg-accent/30 group-hover:bg-accent/60 transition-colors duration-300 rounded-full"></div>
    )}
    <div>
      {gear && (
        <p class="label text-accent tracking-label-wide font-medium mb-1">
          {gear.make} / {gear.model}
        </p>
      )}
      <h2 class="font-serif text-xl font-bold text-ink group-hover:text-accent transition-colors mb-2 leading-snug">
        {title}
      </h2>
      <p class="text-ink/70 text-sm leading-relaxed">{description}</p>
    </div>
  </a>
  <div class="flex items-center gap-4 mt-3">
    <time class="label text-ink/50 tracking-label">{formattedDate}</time>
    {author && <span class="font-mono text-label text-ink/50">by {author}</span>}
    <div class="flex gap-2">
      {tags.map((tag) => (
        <a
          href={tagUrl(tag)}
          class="label text-accent/70 hover:text-accent tracking-label transition-colors"
        >
          #{tag}
        </a>
      ))}
    </div>
  </div>
</article>
