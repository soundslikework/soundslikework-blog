---
import { SITE } from "../site";
const currentPath = Astro.url.pathname;
const Brand = currentPath === '/' ? 'h1' : 'div';

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
---

<div class="h-0.5 bg-accent w-full"></div>

<header class="border-b border-ink/20 py-5">
  <div class="page-container flex items-baseline justify-between">
    <Brand class="font-serif text-2xl font-bold text-ink leading-none">
      <a href="/" class="no-underline hover:text-accent transition-colors">
        {SITE.name}
      </a>
    </Brand>
    <nav>
      <ul class="flex gap-6 list-none m-0 p-0">
        {navLinks.map(({ href, label }) => (
          <li>
            <a
              href={href}
              class={`font-mono text-xs uppercase tracking-widest transition-colors no-underline ${ currentPath === href ? 'text-accent font-medium' : 'text-ink-muted hover:text-accent' }`}
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
