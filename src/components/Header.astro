---
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
];
---

<header class="border-b border-ink/20 py-6 px-6 md:px-8">
  <div class="max-w-2xl mx-auto flex items-baseline justify-between">
    <a href="/" class="font-serif text-2xl font-bold text-ink no-underline hover:text-rust transition-colors">
      Sounds Like Work
    </a>
    <nav>
      <ul class="flex gap-6 list-none m-0 p-0">
        {navLinks.map(({ href, label }) => (
          <li>
            <a
              href={href}
              class={`text-sm uppercase tracking-widest transition-colors no-underline ${
                currentPath === href
                  ? 'text-rust font-semibold'
                  : 'text-ink/70 hover:text-rust'
              }`}
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
