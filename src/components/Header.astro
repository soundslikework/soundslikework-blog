---
const currentPath = Astro.url.pathname;
const isHome = currentPath === '/';

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
];
---

<div class="h-0.5 bg-linear-to-r from-accent-dark via-accent to-accent-light w-full"></div>

<header class="border-b border-ink/20 py-5">
  <div class="max-w-2xl mx-auto px-6 md:px-8 flex items-baseline justify-between">
    {isHome ? (
      <h1 class="font-serif text-2xl font-bold text-ink m-0 p-0 leading-none">
        <a href="/" class="no-underline hover:text-accent transition-colors flex items-baseline gap-2">
          <span class="signal-dot text-accent text-[10px] leading-none relative -top-0.5">●</span>
          Sounds Like Work
        </a>
      </h1>
    ) : (
      <a href="/" class="font-serif text-2xl font-bold text-ink no-underline hover:text-accent transition-colors flex items-baseline gap-2">
        <span class="signal-dot text-accent text-[10px] leading-none relative -top-0.5">●</span>
        Sounds Like Work
      </a>
    )}
    <nav>
      <ul class="flex gap-6 list-none m-0 p-0">
        {navLinks.map(({ href, label }) => (
          <li>
            <a
              href={href}
              class={`font-mono text-xs uppercase tracking-widest transition-colors no-underline ${
                currentPath === href
                  ? 'text-accent font-medium'
                  : 'text-ink/70 hover:text-accent'
              }`}
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
