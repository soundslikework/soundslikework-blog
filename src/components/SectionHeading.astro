---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<div class:list={["flex items-center gap-3", className]}>
  <div class="h-px w-8 bg-accent opacity-50"></div>
  <p class="label tracking-eyebrow text-ink/50"><slot /></p>
  <div class="h-px flex-1 bg-ink/10"></div>
</div>
