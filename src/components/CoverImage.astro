---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  gear?: { make: string; model: string };
  title: string;
  eager?: boolean; // the first big image on a page is the LCP, so don't lazy-load it
  class?: string;
}

const { src, gear, title, eager = false, class: className } = Astro.props;
const alt = gear ? `${gear.make} ${gear.model}` : title;
---

{/* 16:9 crop at 1408w; callers change the box shape with an aspect class, so the file is never upscaled. */}
<Image
  src={src}
  alt={alt}
  width={1408}
  height={792}
  fit="cover"
  widths={[704, 1056, 1408]}
  sizes="(min-width: 768px) 704px, calc(100vw - 3rem)"
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : undefined}
  class:list={['w-full aspect-video object-cover rounded-sm', className]}
/>
