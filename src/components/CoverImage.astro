---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { IMAGE_SIZES, IMAGE_WIDTHS } from '../lib/images';

interface Props {
  src: ImageMetadata;
  gear?: { make: string; model: string };
  title: string;
  eager?: boolean; // the first big image on a page is the LCP, so don't lazy-load it
  uncropped?: boolean; // keep the photo's own shape instead of the 16:9 crop
  class?: string;
}

const { src, gear, title, eager = false, uncropped = false, class: className } = Astro.props;
const alt = gear ? `${gear.make} ${gear.model}` : title;
---

{/* 16:9 crop at 1408w; callers change the box shape with an aspect class, so the file is never upscaled. */}
<Image
  src={src}
  alt={alt}
  width={1408}
  height={uncropped ? undefined : 792}
  fit={uncropped ? undefined : 'cover'}
  widths={IMAGE_WIDTHS}
  sizes={IMAGE_SIZES}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : undefined}
  class:list={['w-full rounded-sm', uncropped ? 'h-auto max-h-[80vh] object-contain' : 'aspect-video object-cover', className]}
/>
