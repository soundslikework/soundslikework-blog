---
import { SITE } from "../site";
const year = new Date().getFullYear();
---

<footer class="border-t border-ink/20 py-8 mt-16">
  <div class="page-container text-center">
    <p class="font-mono text-micro text-ink/30 uppercase tracking-footer mb-1">
      {SITE.name}
    </p>
    <p class="font-mono text-micro text-ink/30 uppercase tracking-label-wide">
      &copy; {year}
    </p>
  </div>
</footer>
