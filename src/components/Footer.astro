---
import { SITE } from "../site";
const year = new Date().getFullYear();
---

<footer class="border-t border-ink/20 py-8 mt-16">
  <div class="max-w-2xl mx-auto px-6 md:px-8 text-center">
    <p class="font-mono text-[9px] text-ink/30 uppercase tracking-[0.3em] mb-1">
      {SITE.name}
    </p>
    <p class="font-mono text-[9px] text-ink/30 uppercase tracking-[0.2em]">
      &copy; {year}
    </p>
  </div>
</footer>
