---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { IMAGE_SIZES, IMAGE_WIDTHS } from '../lib/images';

// In-post photo that keeps its own shape; use in .mdx instead of astro:assets' <Image>, which ships the full source size.
interface Props {
  src: ImageMetadata;
  alt: string;
}

const { src, alt } = Astro.props;
---

<Image src={src} alt={alt} width={1408} widths={IMAGE_WIDTHS} sizes={IMAGE_SIZES} />
