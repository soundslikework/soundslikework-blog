---
import { SITE } from "../site";
import BaseLayout from "./BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Comments from "../components/Comments.astro";
import { getImage } from "astro:assets";
import CoverImage from "../components/CoverImage.astro";
import { tagUrl } from "../posts";
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"posts">;
}

const { post } = Astro.props;
const { title, seoTitle, date, description, coverImage, gear, tags, author } = post.data;

const formattedDate = date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
});

// og:image: a 1200x630 crop, not the multi-MB original (social crawlers skip big files).
const ogImage = coverImage
  ? new URL(
      (await getImage({ src: coverImage, width: 1200, height: 630, format: "jpg" })).src,
      Astro.site,
    ).href
  : undefined;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const displayTitle = seoTitle ?? title;
const postAuthor = author ?? SITE.author;

const blogPostingSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: displayTitle,
  description,
  datePublished: date.toISOString(),
  author: { "@type": "Person", name: postAuthor },
  url: canonicalURL.toString(),
  publisher: {
    "@type": "Organization",
    name: SITE.name,
    url: SITE.url,
  },
  ...(ogImage && { image: ogImage }),
};

const reviewSchema = gear
  ? {
      "@context": "https://schema.org",
      "@type": "Review",
      itemReviewed: {
        "@type": "Product",
        name: `${gear.make} ${gear.model}`,
        brand: { "@type": "Brand", name: gear.make },
      },
      author: { "@type": "Person", name: postAuthor },
      reviewBody: description,
      datePublished: date.toISOString(),
      url: canonicalURL.toString(),
    }
  : null;
---

<BaseLayout
  title={title}
  seoTitle={seoTitle}
  description={description}
  ogImage={ogImage}
  ogType="article"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(blogPostingSchema)} />
    {reviewSchema && <script is:inline type="application/ld+json" set:html={JSON.stringify(reviewSchema)} />}
  </Fragment>
  <Header />
  <main class="page-container py-12">
    <article>
      <header class="mb-10">
        {
          gear && (
            <p class="gear-name mb-3">
              {gear.make} / {gear.model}
            </p>
          )
        }
        <h1 class="page-title text-ink mb-4 leading-tight">
          {title}
        </h1>
        <p class="text-ink-muted text-lg mb-6 leading-relaxed">
          {description}
        </p>
        <div class="flex items-center gap-4 text-sm text-ink-muted mb-6">
          <time class="label">{formattedDate}</time>
          {author && <span class="font-mono text-xs">by {author}</span>}
          {
            tags.length > 0 && (
              <div class="flex gap-2">
                {tags.map((tag) => (
                  <a
                    href={tagUrl(tag)}
                    class="tag"
                  >
                    #{tag}
                  </a>
                ))}
              </div>
            )
          }
        </div>
        {coverImage && <CoverImage src={coverImage} gear={gear} title={title} eager uncropped />}
        <hr class="my-8 border-ink/20" />
      </header>
      <div class="prose prose-retro">
        <slot />
      </div>
    </article>
    <Comments />
  </main>
  <Footer />
</BaseLayout>
