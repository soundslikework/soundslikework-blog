---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { title, date, description, coverImage, pedal, tags, author } = post.data;

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// Build an absolute URL for og:image if the post has a cover image.
// Astro's image optimizer resolves `coverImage` to a final URL at build time;
// cast via `as any` because the type reflects the import, not the built output.
const ogImage = coverImage
  ? new URL((coverImage as any).src, Astro.site ?? 'https://soundslike.work').href
  : undefined;
---

<BaseLayout title={title} description={description} ogImage={ogImage}>
  <Header />
  <main class="max-w-2xl mx-auto px-6 md:px-8 py-12">
    <article>
      <header class="mb-10">
        {pedal && (
          <p class="text-rust text-xs uppercase tracking-widest font-semibold mb-2">
            {pedal.brand} — {pedal.model}
          </p>
        )}
        <h1 class="font-serif text-4xl font-bold text-ink mb-4 leading-tight">{title}</h1>
        <p class="text-ink/60 text-lg mb-6">{description}</p>
        <div class="flex items-center gap-4 text-sm text-ink/50 mb-6">
          <time class="uppercase tracking-wide text-xs">{formattedDate}</time>
          {author && <span>by {author}</span>}
          {tags.length > 0 && (
            <div class="flex gap-2">
              {tags.map((tag) => (
                <a href={`/tags/${tag}`} class="text-rust/80 hover:text-rust uppercase tracking-wide text-xs transition-colors">
                  #{tag}
                </a>
              ))}
            </div>
          )}
        </div>
        {coverImage && (
          <Image
            src={coverImage}
            alt={`${pedal?.brand ?? ''} ${pedal?.model ?? title}`}
            width={680}
            height={400}
            class="w-full rounded-sm object-cover"
          />
        )}
        <hr class="border-ink/20 mt-8" />
      </header>
      <div class="prose prose-retro max-w-none font-sans leading-relaxed">
        <slot />
      </div>
    </article>
  </main>
  <Footer />
</BaseLayout>
